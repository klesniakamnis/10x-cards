<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>10xCards</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="header-content">
            <a href="/" class="site-title">10xCards</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-info">
                    <a href="/create" class="nav-link">Dodaj fiszkę</a>
                    <span class="user-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
                    <form class="logout-form" onsubmit="fetch('/api/auth/logout',{method:'POST'}).then(()=>location.href='/LoginRequired');return false;">
                        <button type="submit" class="btn-logout">Wyloguj</button>
                    </form>
                </div>
            }
        </div>
    </header>
    <main class="main-content">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
