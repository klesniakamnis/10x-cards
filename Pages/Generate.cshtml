@page "/"
@model _10x_cards.Pages.GenerateModel

<div class="generate-page">
    <div class="input-section">
        <label for="source-text">Wklej tekst do wygenerowania fiszek:</label>
        <textarea id="source-text" maxlength="10000" placeholder="Wklej tutaj tekst źródłowy (max. 10 000 znaków)..."></textarea>
        <div class="input-footer">
            <span id="char-counter">0 / 10 000</span>
            <button id="generate-btn" class="btn-primary">Generuj fiszki</button>
        </div>
    </div>
    <div id="error-container"></div>
    <div id="proposals-container"></div>
    <div id="summary-container"></div>
</div>

@section Scripts {
    <script src="~/js/generate.js" asp-append-version="true"></script>
}
